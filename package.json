{
  "name": "antigravity-plugin-hillclimb",
  "version": "0.5.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkLernReBar/antigravity-plugin-hillclimb.git"
  },
  "homepage": "https://github.com/MarkLernReBar/antigravity-plugin-hillclimb#readme",
  "bugs": {
    "url": "https://github.com/MarkLernReBar/antigravity-plugin-hillclimb/issues"
  },
  "description": "Hill Climb plugin for Antigravity: ranked contract trees, auto-tracked repo climbs (climb.py), evolutionary search, benchmark kits, studies, and interactive MCP App UI.",
  "keywords": [
    "antigravity",
    "mcp",
    "mcp-apps",
    "hill-climb",
    "optimization",
    "evals",
    "benchmarking"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "hillclimb": "./dist/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ui": "node scripts/build-ui.mjs",
    "build:server": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/mcp-server.mjs --external:../assets/ci/hillclimb-evidence.mjs --banner:js=\"import{createRequire as __hcReq}from'node:module';const require=__hcReq(import.meta.url);\"",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --external:../assets/ci/hillclimb-evidence.mjs --banner:js=\"import{createRequire as __hcReq}from'node:module';const require=__hcReq(import.meta.url);\"",
    "build": "npm run build:ui && npm run build:server && npm run build:cli",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
